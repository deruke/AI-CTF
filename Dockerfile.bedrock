# Dockerfile for AWS Bedrock Access Gateway (vendored + patched for the CTF)
# Provides an OpenAI-compatible API in front of Amazon Bedrock.
#
# The source is VENDORED in ./bedrock-gateway (from aws-samples/bedrock-access-gateway)
# and carries a local patch to api/models/bedrock.py::_reframe_multi_payloard that
# appends a trailing user turn so Challenge 7 (code interpreter) works over the
# Bedrock Converse API. Do NOT replace this with a fresh `git clone` of upstream
# or that patch is lost.

FROM python:3.12-slim

WORKDIR /app

# Vendored, patched gateway source
COPY bedrock-gateway/ /app/

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Expose port 80 (internal port for the gateway)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:80/health', timeout=5)" || exit 1

# Run the application using uvicorn (app is in api/app.py)
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "80"]
